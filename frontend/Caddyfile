# Si DOMAIN está definido, Caddy sirve en ese dominio con HTTPS automático.
# Si está vacío, sirve en :80 (pruebas locales o VPS sin dominio todavía).
{$DOMAIN::80} {
	encode gzip

	handle /api/* {
		# X-Real-IP = IP real del cliente que ve Caddy ({remote_host}); no es
		# falseable por el cliente. El backend la usa para limitar por IP en
		# lugar de un cubo global compartido (un pico dejaría sin login a todos).
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html

		# Caché correcta tras cada deploy: el HTML y el service worker se
		# REVALIDAN siempre (si no, un index.html cacheado apuntaba a assets
		# hasheados ya purgados → pantalla rota hasta Ctrl+Shift+R); los assets
		# con hash en el nombre son inmutables y se cachean un año.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@revalidate path / /index.html /sw.js
		header @revalidate Cache-Control "no-cache"

		file_server
	}
}
